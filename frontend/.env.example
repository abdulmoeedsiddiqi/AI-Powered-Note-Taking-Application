# Base URL of the backend API.
# - Local dev: point at the running backend.
# - Production on Vercel (single project): the API is served from the same
#   domain under /api, so you can leave this UNSET (the app defaults to "/api").
VITE_API_BASE_URL=http://localhost:4200

# Real-time note sync is delivered via Ably and configured entirely on the
# backend (see ABLY_API_KEY in backend/.env). No frontend variable is needed —
# the browser fetches a scoped Ably token from /auth/ably-token.
