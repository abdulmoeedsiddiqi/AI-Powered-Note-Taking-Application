# Base URL of the backend API.
# - Local dev: point at the running backend.
# - Production on Vercel (single project): the API is served from the same
#   domain under /api, so you can leave this UNSET (the app defaults to "/api").
VITE_API_BASE_URL=http://localhost:4200

# Enable Socket.IO real-time cross-tab sync. Requires a WebSocket-capable
# backend (local dev, or a non-serverless host). Leave unset/false on Vercel
# serverless — lists still refresh via React Query on mutation + window focus.
VITE_ENABLE_REALTIME=true
