NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
DATABASE_URL=postgresql://notes_app:notes_app@localhost:5433/notes_app?schema=public
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=auth_token
# Any OpenAI-compatible chat completions API works here (OpenAI, Groq,
# Gemini, ...) — just swap all three values for your provider of choice.
# Required for the "Summarize" feature only.
#
# Option 1: OpenAI (get a key at https://platform.openai.com)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
#
# Option 2: Groq (100% free, get a key at https://console.groq.com/keys)
# AI_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant
#
# Fallback mode: gracefully generate local extractive summaries if external AI fails/exhausts quota
AI_ENABLE_FALLBACK=true

# --- Production (Vercel) ---
# Set NODE_ENV=production so the auth cookie is marked Secure.
# DATABASE_URL: a managed, pooled Postgres connection string (Neon/Supabase/
#   Vercel Postgres). Prefer the *pooled* URL for serverless (e.g. Neon's
#   "-pooler" host or a PgBouncer/pooling endpoint).
# JWT_SECRET: a long random value (e.g. `openssl rand -hex 32`) — never the dev default.
# CORS_ORIGIN: not needed when frontend + API share a domain (single Vercel project).
# BLOB_READ_WRITE_TOKEN: enables Vercel Blob storage for uploads instead of local
#   disk. Created automatically when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=
